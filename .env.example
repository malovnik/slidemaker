# Все переменные необязательные — локально приложение работает и без них.

# Пин-код на вход. Пусто или не задано — вход свободный.
# ОБЯЗАТЕЛЬНО задайте, если выкладываете приложение в интернет.
PIN_CODE=

# Ключ подписи сессий. Локально генерируется сам при каждом запуске.
# На сервере задайте свой длинный случайный, иначе после перезапуска
# всех пользователей будет выкидывать из сессии.
SECRET_KEY=

# Ключ OpenAI — нужен только для кнопки «AI-агент»,
# которая превращает сырой текст в готовый Markdown для слайдов.
# Без ключа работает всё остальное.
OPENAI_API_KEY=

# Максимальный размер загружаемого файла в мегабайтах (по умолчанию 32)
MAX_UPLOAD_MB=32

# Порт локального сервера (по умолчанию 5000)
PORT=5000
